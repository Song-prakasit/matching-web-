# ===== ระบบ Matching (เว็บ) =====
PORT=3000

# mock = ใช้ข้อมูลจำลองในเครื่อง (ไม่ต้องต่อ server จริง)
# mssql = ต่อ SQL Server จริง
DB_MODE=mock

# ----- SQL Server (ใช้เมื่อ DB_MODE=mssql) -----
DB_SERVER=10.0.0.77
DB_DATABASE=IPharmaDB
# ใส่ user/password แบบปกติ หรือคัดลอกค่า Uid/Pwd ที่เข้ารหัสแล้วจาก system.ini เดิมมาใส่ใน *_ENC
DB_USER=
DB_PASSWORD=
DB_USER_ENC=
DB_PASSWORD_ENC=

# ----- การเข้าสู่ระบบ -----
# สุ่มข้อความยาว ๆ มาใส่ (ห้ามใช้ค่าตัวอย่าง)
JWT_SECRET=
SESSION_HOURS=12
SCAN_LOOKBACK_DAYS=1

# ----- คีย์เข้ารหัสของระบบเดิม: คัดลอกจาก DBManager/Properties/Resources.resx (Key, initVector, PasswdDerive) -----
LEGACY_SALT=
LEGACY_IV=
LEGACY_PASSPHRASE=

# ----- HTTPS (จำเป็นถ้าจะใช้กล้องสแกน QR บนแท็บเล็ต/มือถือ) -----
# HTTPS_KEY=C:\certs\server.key
# HTTPS_CERT=C:\certs\server.crt